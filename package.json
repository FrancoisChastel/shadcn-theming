{
  "name": "shadcn-theming",
  "version": "0.1.0",
  "description": "Adapt shadcn/ui to any company brand. Turn a brand guide, logo, website, or design tokens into contrast-safe OKLCH theme tokens, patch globals.css, and emit a shareable shadcn registry theme.",
  "keywords": [
    "shadcn",
    "shadcn-ui",
    "theme",
    "theming",
    "branding",
    "design-tokens",
    "oklch",
    "tailwind",
    "registry",
    "cli"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Francois Chastel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FrancoisChastel/shadcn-theming.git"
  },
  "bin": {
    "shadcn-theming": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/cli.js",
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "registry:build": "node scripts/build-registry.mjs",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^0.10.0",
    "commander": "^13.1.0",
    "culori": "^4.0.1",
    "node-html-parser": "^7.0.1",
    "node-vibrant": "^4.0.3",
    "picocolors": "^1.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/culori": "^2.1.1",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^2.1.8",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
